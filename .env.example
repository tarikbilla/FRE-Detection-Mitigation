# FRE platform configuration template.
# Copy to /etc/fre-platform/fre.env (service) or ./.env (development) and fill in.
# NEVER commit the filled-in file. .env and *.env are git-ignored.

# ---- MongoDB Atlas (secret) ----
# Either a full connection string ...
FRE_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# ... or the three parts (used when FRE_MONGODB_URI is not set; password is URL-encoded):
#FRE_MONGODB_USERNAME=<user>
#FRE_MONGODB_PASSWORD=<password>
#FRE_MONGODB_HOST=<cluster-host e.g. cluster0.abcde.mongodb.net>
FRE_MONGODB_DB=fre_dataset

# ---- Station / experiment metadata ----
FRE_STATION_ID=kali-raspberrypi
FRE_DATASET_VERSION=2026.11-v1
FRE_EXPERIMENT_ID=baseline-001
FRE_EXPERIMENT_DESCRIPTION=Passive long-wave baseline observation (receive-only)
FRE_ANTENNA=unspecified
FRE_LOCATION_LABEL=lab

# ---- Receiver (receive-only Airspy HF+ Discovery) ----
FRE_SOURCE=airspyhf
FRE_RECEIVER_MODEL=Airspy HF+ Discovery
FRE_CENTER_FREQ_HZ=108000
FRE_SAMPLE_RATE_HZ=192000
FRE_BLOCK_SECONDS=1.0
FRE_CHANNELS=DCF77:77500,DCF49:129100,HGA22:135600,DCF39:139000
FRE_AIRSPY_AGC=true
FRE_AIRSPY_ATTENUATION=0
FRE_AIRSPY_LNA=false
#FRE_AIRSPY_SERIAL=0x0123456789ABCDEF

# ---- Storage / upload ----
FRE_DATA_DIR=/var/lib/fre-platform
FRE_LOG_DIR=/var/log/fre-platform
FRE_MODEL_PATH=/var/lib/fre-platform/models/fre_models.joblib
# Sized for the Atlas free tier (M0, 512 MB): ~10 MB/day.
FRE_BATCH_SIZE=100
FRE_UPLOAD_INTERVAL_S=30
FRE_MAX_BUFFER_ROWS=200000
FRE_OBSERVATION_EVERY_N_BLOCKS=60    # per-channel feature observation cadence (blocks)
FRE_SPECTRUM_EVERY_N_BLOCKS=600      # band spectrum snapshot cadence (blocks)
FRE_PSD_BINS=128
FRE_ATLAS_QUOTA_MB=512
FRE_ATLAS_SOFT_LIMIT_PCT=85

# ---- Telegram decoding (receive-only) ----
FRE_DECODE_TELEGRAMS=true
FRE_TELEGRAM_REQUIRE_CHECKSUM=true

# ---- Detection / ML (phase 2; off while building the research dataset) ----
FRE_ENABLE_DETECTION=false

# ---- Logging ----
FRE_LOG_LEVEL=INFO
FRE_LOG_FORMAT=json
