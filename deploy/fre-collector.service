[Unit]
Description=FRE receive-only collector (Airspy HF+ Discovery -> local buffer -> MongoDB Atlas)
Documentation=file://@REPO_DIR@/README.md
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=plugdev
WorkingDirectory=@REPO_DIR@
# Secrets and settings live outside the repository (root-owned, mode 0640).
EnvironmentFile=/etc/fre-platform/fre.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_DIR@/.venv/bin/python -m fre_platform collect
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
StateDirectory=fre-platform
StateDirectoryMode=0750
LogsDirectory=fre-platform
LogsDirectoryMode=0750

# Hardening (USB access to the receiver is still required, so no PrivateDevices)
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
