# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.env
!*.env.example
*credentials*
*.pem
*.key
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ---- Runtime data (local only) ----
data/
logs/
*.sqlite3
*.sqlite3-*
*.db
*.cf32
*.iq
*.npy
models/*.joblib
!models/.gitkeep

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store

